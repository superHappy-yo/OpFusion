{
  "schema_version": "0.2.0",
  "status": "documentation_only_not_enforced",
  "interpretation": "仓库相对路径；普通任务allowlist与目标模块范围取交集。用户明确授权的契约/集成/治理任务另列精确范围。此文件自身不能授权任务扩大范围。",
  "protected_globs": [
    "AGENTS.md",
    "CLAUDE.md",
    "**/AGENTS.md",
    "**/CLAUDE.md",
    "docs/ai/**",
    "docs/architecture/**",
    ".github/**",
    "modules/contracts/**",
    "pyproject.toml",
    "uv.lock",
    "requirements*.txt",
    "CMakeLists.txt",
    "Dockerfile*",
    "deploy/**"
  ],
  "scopes": {
    "contracts": {
      "owned_roots": [
        "modules/contracts/"
      ],
      "default_write_globs": [
        "modules/contracts/**"
      ],
      "always_protected_instruction_files": true,
      "allowed_business_dependencies": [],
      "contract_edit_requires_contract_task": true
    },
    "frontend": {
      "owned_roots": [
        "modules/frontend/"
      ],
      "default_write_globs": [
        "modules/frontend/**"
      ],
      "always_protected_instruction_files": true,
      "allowed_business_dependencies": [
        "contracts"
      ],
      "contract_edit_requires_contract_task": false
    },
    "backends": {
      "owned_roots": [
        "modules/backends/"
      ],
      "default_write_globs": [
        "modules/backends/**"
      ],
      "always_protected_instruction_files": true,
      "allowed_business_dependencies": [
        "contracts"
      ],
      "contract_edit_requires_contract_task": false
    },
    "cost_model": {
      "owned_roots": [
        "modules/cost_model/"
      ],
      "default_write_globs": [
        "modules/cost_model/**"
      ],
      "always_protected_instruction_files": true,
      "allowed_business_dependencies": [
        "contracts"
      ],
      "contract_edit_requires_contract_task": false
    },
    "fusion": {
      "owned_roots": [
        "modules/fusion/"
      ],
      "default_write_globs": [
        "modules/fusion/**"
      ],
      "always_protected_instruction_files": true,
      "allowed_business_dependencies": [
        "contracts"
      ],
      "contract_edit_requires_contract_task": false
    },
    "planner": {
      "owned_roots": [
        "modules/planner/"
      ],
      "default_write_globs": [
        "modules/planner/**"
      ],
      "always_protected_instruction_files": true,
      "allowed_business_dependencies": [
        "contracts"
      ],
      "contract_edit_requires_contract_task": false
    },
    "codegen": {
      "owned_roots": [
        "modules/codegen/"
      ],
      "default_write_globs": [
        "modules/codegen/**"
      ],
      "always_protected_instruction_files": true,
      "allowed_business_dependencies": [
        "contracts"
      ],
      "contract_edit_requires_contract_task": false
    },
    "runtime": {
      "owned_roots": [
        "modules/runtime/"
      ],
      "default_write_globs": [
        "modules/runtime/**"
      ],
      "always_protected_instruction_files": true,
      "allowed_business_dependencies": [
        "contracts"
      ],
      "contract_edit_requires_contract_task": false
    },
    "experiments": {
      "owned_roots": [
        "modules/experiments/"
      ],
      "default_write_globs": [
        "modules/experiments/**"
      ],
      "always_protected_instruction_files": true,
      "allowed_business_dependencies": [
        "contracts",
        "apps"
      ],
      "contract_edit_requires_contract_task": false
    },
    "apps": {
      "owned_roots": [
        "apps/"
      ],
      "default_write_globs": [
        "apps/**"
      ],
      "always_protected_instruction_files": true,
      "allowed_business_dependencies": [
        "contracts",
        "frontend",
        "backends",
        "cost_model",
        "fusion",
        "planner",
        "codegen",
        "runtime",
        "extensions"
      ],
      "role": "composition_root_only",
      "extension_dependency_rule": "仅统一发现器按已校验manifest解析本包工厂；不维护逐插件导入，不访问插件私有对象。"
    },
    "extensions": {
      "owned_roots": [
        "extensions/"
      ],
      "default_write_globs": [],
      "requires_explicit_plugin_root": true,
      "allowed_plugin_kinds": [
        "operators",
        "devices",
        "compilers",
        "implementations"
      ],
      "unit_path_template": "extensions/{kind}/{plugin_id}/",
      "unit_write_rule": "普通扩展任务将授权的单个插件根代入后只允许其下文件；不能将占位符、*、父目录跳转或extensions/**当作任务根；治理文件始终受保护。",
      "always_protected_instruction_files": true,
      "allowed_business_dependencies": [
        "contracts"
      ],
      "cross_plugin_imports": "forbidden; use declared provider ids and injected ports"
    }
  },
  "special_tasks": {
    "contract_change": "明确列出contracts文件与受影响消费者的集成任务；生产者/消费者分别限定范围。",
    "integration": "仅用户已授权范围；由装配任务拆分，不能将整个仓库隐含为可写。",
    "governance": "明确涉及提示词/范围/所有权/构建/CI的任务才可改相应受保护路径。",
    "extension": "只增加或修改用户授权的单个扩展包；契约/发现器/根依赖变化属于另列范围的集成任务。"
  }
}
